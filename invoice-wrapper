#!/bin/bash
# Wrapper script for invoice.py that automatically handles virtual environment

# Resolve symlink chain to find the real project directory
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
VENV_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Resolve the active venv (if any) to an absolute path for comparison, so we
# only trust it if it's THIS project's own venv and not some unrelated
# project's virtualenv left active in the shell.
RESOLVED_VIRTUAL_ENV=""
if [[ "$VIRTUAL_ENV" != "" ]]; then
    RESOLVED_VIRTUAL_ENV="$(cd -P "$VIRTUAL_ENV" 2>/dev/null && pwd)"
fi

# Check if we're already in this project's own venv
if [[ "$RESOLVED_VIRTUAL_ENV" != "" && "$RESOLVED_VIRTUAL_ENV" == "$VENV_DIR/venv" && -x "$VIRTUAL_ENV/bin/python" ]]; then
    # Already in this project's venv, just run the command
    "$VIRTUAL_ENV/bin/python" "$VENV_DIR/invoice.py" "$@"
else
    # Not in venv, activate it first
    VENV="$VENV_DIR/venv"

    if [[ -d "$VENV" ]]; then
        # Activate venv and run command
        "$VENV/bin/python" "$VENV_DIR/invoice.py" "$@"
    else
        echo "Virtual environment not found at: $VENV"
        echo "Please run:"
        echo "  cd $VENV_DIR"
        echo "  python -m venv venv"
        echo "  source venv/bin/activate"
        echo "  pip install -r requirements.txt"
        exit 1
    fi
fi
