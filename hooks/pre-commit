#!/usr/bin/env bash
# Pre-commit: enforce source size, staged Python quality, and the PII guard.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
patterns="$repo_root/hooks/pii-patterns.txt"
local_patterns="$repo_root/hooks/pii-patterns.local.txt"

if ! command -v python3 >/dev/null 2>&1; then
    echo "[pre-commit] BLOCKED: python3 is required to run the staged file-size check." >&2
    exit 1
fi
if ! python3 "$repo_root/scripts/check_file_size.py" --staged; then
    echo "[pre-commit] BLOCKED: staged source files exceed the size policy or Git could not read them." >&2
    exit 1
fi

# Lint index blobs, so unstaged fixes cannot hide staged unused imports.
staged_py=()
while IFS= read -r -d '' staged_file; do
    staged_py+=("$staged_file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.py')
if (( ${#staged_py[@]} > 0 )); then
    if command -v ruff >/dev/null 2>&1; then
        for staged_file in "${staged_py[@]}"; do
            set +e
            git cat-file blob ":$staged_file" 2>/dev/null | (cd "$repo_root" && ruff check --output-format concise --select F401 --no-cache --stdin-filename "$staged_file" -) >/dev/null 2>&1
            pipeline_status=("${PIPESTATUS[@]}")
            set -e
            git_status="${pipeline_status[0]}"
            ruff_status="${pipeline_status[1]}"
            if (( git_status != 0 )); then
                printf '[pre-commit] BLOCKED: Git could not read staged Python file %q (exit %s).\n' "$staged_file" "$git_status" >&2
                exit 1
            elif (( ruff_status == 1 )); then
                printf '[pre-commit] BLOCKED: Ruff found staged unused imports (F401) in %q (exit %s).\n' "$staged_file" "$ruff_status" >&2
                echo "[pre-commit] Remove them, or mark an intentional re-export with '# noqa: F401 - <who uses it>'." >&2
                exit 1
            elif (( ruff_status != 0 )); then
                printf '[pre-commit] BLOCKED: Ruff tool/config failure while checking %q (exit %s).\n' "$staged_file" "$ruff_status" >&2
                exit 1
            fi
        done
    else
        echo "[pre-commit] notice: ruff not found; skipping the unused-import check." >&2
    fi
fi

if [[ ! -f "$patterns" ]]; then
    echo "[pre-commit] BLOCKED: pattern file missing: $patterns" >&2
    echo "[pre-commit] Cannot verify staged content is free of PII without it." >&2
    exit 1
fi

# The local list contains private identifiers and must never be staged.
if git diff --cached --name-only -- hooks/pii-patterns.local.txt | grep -q .; then
    echo "[pre-commit] BLOCKED: hooks/pii-patterns.local.txt is staged." >&2
    echo "[pre-commit] It holds real identifiers and must stay local: git restore --staged hooks/pii-patterns.local.txt" >&2
    exit 1
fi

# The tracked generic list is exempt because it contains the patterns themselves.
staged_diff="$(git diff --cached --no-color -U0 -- ':(exclude)hooks/pii-patterns.txt')"
if [[ -z "$staged_diff" ]]; then
    exit 0
fi

if printf '%s\n' "$staged_diff" | grep -q '^Binary files .* differ$'; then
    cat >&2 <<EOF

[pre-commit] BLOCKED: staged diff includes a binary file that cannot be
scanned for PII patterns.

$(printf '%s\n' "$staged_diff" | grep '^Binary files .* differ$')

Review the binary for PII before adding it. If it cannot be safely scanned,
keep it out of the repository.

EOF
    exit 1
fi

# Track hunk boundaries so a content line beginning with '+' is scanned,
# while the +++ b/path file header is ignored.
added_lines="$(printf '%s\n' "$staged_diff" | awk '
    /^diff --git / { in_hunk = 0; next }
    /^@@/          { in_hunk = 1; next }
    in_hunk && /^\+/ { print substr($0, 2) }
')"
if [[ -z "$added_lines" ]]; then
    exit 0
fi

pattern_files=("$patterns")
if [[ -f "$local_patterns" ]]; then
    pattern_files+=("$local_patterns")
else
    echo "[pre-commit] notice: hooks/pii-patterns.local.txt not found; only the generic tracked patterns are active." >&2
fi
pattern_list="$(grep -hEv '^[[:space:]]*(#|$)' "${pattern_files[@]}" || true)"
if [[ -z "$pattern_list" ]]; then
    echo "[pre-commit] BLOCKED: ${pattern_files[*]} has no active patterns (all blank/comments)." >&2
    echo "[pre-commit] Cannot verify staged content is free of PII without it." >&2
    exit 1
fi

# grep uses 1 for a clean scan and >=2 for malformed patterns or I/O errors.
set +e
hit_count="$(printf '%s\n' "$added_lines" | grep -ciE -f <(printf '%s\n' "$pattern_list"))"
grep_status=$?
set -e
if [[ $grep_status -ge 2 ]]; then
    echo "[pre-commit] BLOCKED: grep failed while scanning staged content (exit $grep_status)." >&2
    echo "[pre-commit] Check ${pattern_files[*]} for a malformed regex." >&2
    exit 1
fi
if [[ $grep_status -eq 0 && "$hit_count" -gt 0 ]]; then
    cat >&2 <<EOF

[pre-commit] BLOCKED: staged content contains forbidden PII / sensitive patterns.
Matching added-line count: $hit_count

Rule: README.md → "No PII in the project".
Pattern list: ${pattern_files[*]}

Fix the staged content and retry.

EOF
    exit 1
fi

exit 0
