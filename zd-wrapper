#!/bin/bash
# Wrapper for zd.py — mirrors the invoice-wrapper pattern.
# Symlink this to ~/.local/bin/zd for global access.

# Resolve symlink chain to find the real project directory
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Resolve the active venv (if any) to an absolute path for comparison, so we
# only trust it if it's THIS project's own venv and not some unrelated
# project's virtualenv left active in the shell.
RESOLVED_VIRTUAL_ENV=""
if [[ "$VIRTUAL_ENV" != "" ]]; then
    RESOLVED_VIRTUAL_ENV="$(cd -P "$VIRTUAL_ENV" 2>/dev/null && pwd)"
fi

if [[ "$RESOLVED_VIRTUAL_ENV" != "" && "$RESOLVED_VIRTUAL_ENV" == "$PROJECT_DIR/venv" && -x "$VIRTUAL_ENV/bin/python" ]]; then
    "$VIRTUAL_ENV/bin/python" "$PROJECT_DIR/zd.py" "$@"
else
    VENV="$PROJECT_DIR/venv"
    if [[ -d "$VENV" ]]; then
        "$VENV/bin/python" "$PROJECT_DIR/zd.py" "$@"
    else
        echo "Virtual environment not found at: $VENV"
        echo "Please run:"
        echo "  cd $PROJECT_DIR"
        echo "  python -m venv venv"
        echo "  source venv/bin/activate"
        echo "  pip install -r requirements.txt"
        exit 1
    fi
fi
